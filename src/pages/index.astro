---
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import AdSlot from '../components/AdSlot.astro';
import Article from '../components/Article.astro';
import Faq from '../components/Faq.astro';
import site from '../site.config.ts';
import { faq } from '../data/faq.ts';

const base = `https://${site.domain}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: site.name,
    url: `${base}/`,
    description: site.description,
    applicationCategory: site.category,
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    inLanguage: site.locale,
    author: { '@type': 'Person', name: 'Abhishek Mishra', jobTitle: 'Software Development Engineer', worksFor: { '@type': 'Organization', name: 'Oqu AI' }, url: 'https://bingemind.com/abhishek-mishra/' },
    publisher: { '@type': 'Organization', name: 'Bingemind', url: 'https://bingemind.com/' },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: ['Grams of starter, flour and water for 1:1:1, 1:2:2, 1:3:3, 1:4:4, 1:5:5, 1:10:10 or a custom ratio', 'Hydration setting', 'Flour mix of white, whole wheat and rye', 'Discard amount from the starter in your jar', 'Rough peak time by kitchen temperature, with clock times', 'Grams, ounces or cups', 'Share link and printable fridge card'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base jsonLd={jsonLd}>
  <section class="mx-auto max-w-5xl px-4 pt-5 sm:pt-14">
    <p class="mb-3 inline-block rounded-full bg-brand-soft px-3 py-1 text-sm font-medium text-brand-ink">{site.tagline}</p>
    <h1 class="serif max-w-3xl text-3xl font-bold leading-[1.08] tracking-tight [text-wrap:balance] sm:text-5xl">
      Sourdough starter feeding calculator
    </h1>
    <p class="mt-3 max-w-2xl text-base text-muted sm:text-lg">Pick a ratio. Get the grams of starter, flour and water to feed, and a rough time to peak.</p>
    <div class="mt-6 sm:mt-8"><Tool /></div>
    <AdSlot />
  </section>
  <Article />
  <Faq />
</Base>

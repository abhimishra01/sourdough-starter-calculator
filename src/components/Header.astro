---
import site from '../site.config.ts';
import ThemeToggle from './ThemeToggle.astro';
import { href } from '../lib/url.js';
const path = Astro.url.pathname;
const links = [
  { href: href(''), label: 'Calculator' },
  { href: href('about/'), label: 'About' },
  { href: href('contact/'), label: 'Contact' },
];
---
<header class="sticky top-0 z-20 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4">
    <a href={href('')} class="flex items-center gap-2.5 font-bold tracking-tight text-ink no-underline">
      <img src={href('favicon.svg')} alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
      <span class="serif text-lg leading-none">{site.name}</span>
    </a>
    <div class="flex items-center gap-1">
      <a href="https://bingemind.com/tools/" class="whitespace-nowrap rounded-full px-3 py-3 text-sm font-medium text-brand-ink no-underline hover:underline max-[420px]:px-2">More free tools</a>
      <nav aria-label="Main" class="hidden items-center sm:flex">
        {links.map((l) => (
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined}
            class="rounded-full px-3 py-2 text-sm font-medium text-muted no-underline hover:text-ink aria-[current=page]:text-ink aria-[current=page]:bg-brand-soft">{l.label}</a>
        ))}
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

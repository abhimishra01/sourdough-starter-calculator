---
import { computeFeed, feedNote, ratioHint, ratioFlavor, jarLine, clockText, parseClock, peakTime, peakText, peakNote, fToC, RATIO_KEYS } from '../lib/starter.js';
import { href } from '../lib/url.js';

// Default state. The page is rendered with these numbers, so it shows a real answer before any script runs.
// A landing page passes `preset` to open the tool on its own case.
interface Props { preset?: Record<string, unknown>; }
const preset = Astro.props.preset;
const d = { mode: 'keep', amount: 50, ratio: '1:1:1', hydration: 100, tempF: 75, jar: '', fedAt: '', readyBy: '', unit: 'g', custom: { s: 1, f: 4, w: 4 }, ...(preset ?? {}) } as any;
const r = computeFeed({ mode: d.mode, amount: d.amount, ratio: d.ratio, hydration: d.hydration, jar: d.jar, mix: { wheat: 0, rye: 0 } });
const jarText = jarLine(r) ?? 'Type the weight of the starter in your jar to see how much to discard.';
const amountChips = { keep: [20, 50, 100, 200], total: [80, 120, 200, 300] };
const p = peakTime(r.dilution, fToC(d.tempF));
const clockInit = clockText({ pk: p, tC: fToC(d.tempF), fed: parseClock(d.fedAt), ready: parseClock(d.readyBy), ratio: d.ratio });
const liveText = `Feed ${r.starter} g starter, ${r.flour.total} g flour and ${r.water} g water.`;
---
<section id="tool" data-preset={preset ? 'yes' : undefined} aria-label="Sourdough starter feeding calculator" class="grid gap-4 lg:grid-cols-2 lg:gap-6">
  <!-- Basics -->
  <div class="rounded-2xl border border-line bg-card p-4 sm:p-6 lg:col-start-1 lg:row-start-1">
    <fieldset>
      <legend class="lbl">What do you know?</legend>
      <div class="seg">
        <label><input type="radio" name="mode" value="keep" checked={d.mode === 'keep'} /><span>Starter I keep</span></label>
        <label><input type="radio" name="mode" value="total" checked={d.mode === 'total'} /><span>Total I need</span></label>
      </div>
    </fieldset>

    <div class="mt-5">
      <label for="amount" id="amount-label" class="lbl">{d.mode === 'keep' ? 'Starter you keep (grams)' : 'Total starter you need (grams)'}</label>
      <div class="flex items-center gap-2">
        <button type="button" id="amount-down" class="step-btn" aria-label="Decrease amount">&minus;</button>
        <input id="amount" class="field text-center text-xl font-semibold" type="text" inputmode="decimal" value={d.amount} autocomplete="off" aria-describedby="note" />
        <button type="button" id="amount-up" class="step-btn" aria-label="Increase amount">+</button>
      </div>
      <p id="amount-hint" class="hint">{d.mode === 'keep' ? 'The starter left in the jar after you discard.' : 'The weight of fed starter you want. For a recipe that asks for 120 g of levain, enter 120.'}</p>
      {(['keep', 'total'] as const).map((m) => (
        <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label={m === 'keep' ? 'Common amounts to keep' : 'Common amounts a recipe needs'} data-chips={m} hidden={d.mode !== m}>
          {amountChips[m].map((n) => <button type="button" class="chip" data-amount={n} aria-pressed={n === d.amount ? 'true' : 'false'}>{n} g</button>)}
        </div>
      ))}
    </div>

    <div class="mt-5">
      <label for="jar" class="lbl">Starter in my jar now (grams, optional)</label>
      <input id="jar" class="field" type="text" inputmode="decimal" placeholder="For example 300" value={d.jar} autocomplete="off" aria-describedby="jar-line" />
      <p class="hint">Weigh the jar, then subtract the empty jar. We use it to tell you how much to discard.</p>
    </div>

    <fieldset class="mt-5">
      <legend class="lbl">Feeding ratio (starter : flour : water)</legend>
      <div class="tiles">
        {RATIO_KEYS.map((v) => (
          <label><input type="radio" name="ratio" value={v} checked={v === d.ratio} /><span>{v === 'custom' ? 'Custom' : v}</span></label>
        ))}
      </div>
      <div id="custom" class="mt-3 grid grid-cols-3 gap-2" hidden>
        <div><label for="c-s" class="lbl">Starter</label><input id="c-s" class="field text-center" type="text" inputmode="decimal" value={d.custom.s} aria-describedby="note" /></div>
        <div><label for="c-f" class="lbl">Flour</label><input id="c-f" class="field text-center" type="text" inputmode="decimal" value={d.custom.f} aria-describedby="note" /></div>
        <div><label for="c-w" class="lbl">Water</label><input id="c-w" class="field text-center" type="text" inputmode="decimal" value={d.custom.w} aria-describedby="note" /></div>
      </div>
      <p id="ratio-hint" class="hint">{ratioHint(r)}</p>
      <p class="hint"><span id="ratio-flavor">{ratioFlavor(d.ratio)}</span> <a href={href('') + '#ratio-meaning'} class="underline underline-offset-2">1:1:1 versus 1:5:5</a></p>
    </fieldset>
  </div>

  <!-- Result -->
  <div id="result" class="rounded-2xl border border-brand/30 bg-brand-soft p-4 sm:p-6 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-start lg:sticky lg:top-20">
    <div class="flex items-center justify-between gap-3">
      <h2 class="serif text-xl font-bold">Your feeding</h2>
      <fieldset class="w-52 shrink-0">
        <legend class="sr-only">Show amounts in grams, ounces or cups</legend>
        <div class="seg">
          <label><input type="radio" name="unit" value="g" checked={d.unit === 'g'} /><span>g</span></label>
          <label><input type="radio" name="unit" value="oz" checked={d.unit === 'oz'} /><span>oz</span></label>
          <label><input type="radio" name="unit" value="cups" checked={d.unit === 'cups'} /><span>Cups</span></label>
        </div>
      </fieldset>
    </div>

    <p id="live" class="sr-only" aria-live="polite" aria-atomic="true">{liveText}</p>
    <div>
      <dl class="mt-4 divide-y divide-line rounded-xl border border-line bg-card">
        <div class="flex items-baseline justify-between gap-3 px-4 py-3">
          <dt class="font-medium">Starter</dt>
          <dd id="out-starter" class="serif text-3xl font-bold tabular-nums">{r.starter} g</dd>
        </div>
        <div class="flex items-baseline justify-between gap-3 px-4 py-3">
          <dt class="font-medium">Flour</dt>
          <dd id="out-flour" class="serif text-3xl font-bold tabular-nums">{r.flour.total} g</dd>
        </div>
        <div id="row-white" class="flex justify-between gap-3 py-2 pl-8 pr-4 text-sm text-muted" hidden><dt>White flour</dt><dd id="out-white" class="tabular-nums"></dd></div>
        <div id="row-wheat" class="flex justify-between gap-3 py-2 pl-8 pr-4 text-sm text-muted" hidden><dt>Whole wheat flour</dt><dd id="out-wheat" class="tabular-nums"></dd></div>
        <div id="row-rye" class="flex justify-between gap-3 py-2 pl-8 pr-4 text-sm text-muted" hidden><dt>Rye flour</dt><dd id="out-rye" class="tabular-nums"></dd></div>
        <div class="flex items-baseline justify-between gap-3 px-4 py-3">
          <dt class="font-medium">Water</dt>
          <dd id="out-water" class="serif text-3xl font-bold tabular-nums">{r.water} g</dd>
        </div>
        <div class="flex items-baseline justify-between gap-3 px-4 py-3">
          <dt class="font-medium text-muted">Total after feeding</dt>
          <dd id="out-total" class="serif text-xl font-semibold tabular-nums text-muted">{r.total} g</dd>
        </div>
      </dl>

      <div class="mt-3 rounded-xl border border-line bg-card px-4 py-3">
        <p class="text-sm font-semibold">Discard</p>
        <p id="jar-line" class="mt-0.5 min-h-[3.5rem] text-sm leading-relaxed">{jarText}</p>
      </div>

      <p id="note" class="mt-3 min-h-[5.5rem] text-sm leading-relaxed text-muted">{feedNote(r)}</p>

      <div class="mt-3 rounded-xl border border-line bg-card px-4 py-3">
        <p class="text-sm font-semibold">Rough peak time</p>
        <p id="peak" class="serif mt-0.5 text-2xl font-bold">{peakText(r.dilution, d.tempF)}</p>
        <p id="peak-note" class="mt-1 min-h-[4rem] text-sm leading-relaxed text-muted">{peakNote(p, d.tempF, 'F', 0)}</p>
        <p id="clock-line" class="mt-1 text-sm font-medium" hidden={!clockInit}>{clockInit}</p>
      </div>
    </div>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
      <p id="cups-note" class="min-w-0 flex-1 basis-48 text-sm text-muted" hidden>Cups are a guess. A cup of flour can weigh 100 to 150 g. Grams are better. The total stays in grams.</p>
      <div class="ml-auto flex flex-wrap gap-2">
        <button type="button" id="copy" class="chip whitespace-nowrap">Copy amounts</button>
        <button type="button" id="share" class="chip whitespace-nowrap">Copy link</button>
        <button type="button" id="print" class="chip whitespace-nowrap">Print fridge card</button>
      </div>
    </div>
    <p id="copy-status" class="min-h-5 text-right text-sm text-muted" role="status"></p>
  </div>

  <!-- Fine-tune -->
  <div class="rounded-2xl border border-line bg-card p-4 sm:p-6 lg:col-start-1 lg:row-start-2">
    <h2 class="serif text-xl font-bold">Fine-tune</h2>

    <div id="hyd-block" class="mt-4">
      <label for="hydration" class="lbl">Hydration (water as % of flour)</label>
      <input id="hydration" class="field" type="text" inputmode="decimal" value={d.hydration} autocomplete="off" aria-describedby="note" />
      <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Common hydration values">
        {[100, 80, 60].map((n) => <button type="button" class="chip" data-hydration={n} aria-pressed={n === d.hydration ? 'true' : 'false'}>{n}%{n === 100 ? ' liquid' : n === 60 ? ' stiff' : ''}</button>)}
      </div>
      <p class="hint">100% means equal flour and water. Used with the preset ratios.</p>
    </div>

    <div id="temp-block" class="mt-5">
      <label for="temp" class="lbl">Kitchen temperature</label>
      <div class="flex items-center gap-2">
        <input id="temp" class="field" type="text" inputmode="decimal" value={d.tempF} autocomplete="off" />
        <fieldset class="w-36 shrink-0">
          <legend class="sr-only">Temperature unit</legend>
          <div class="seg">
            <label><input type="radio" name="tunit" value="F" checked /><span>&deg;F</span></label>
            <label><input type="radio" name="tunit" value="C" /><span>&deg;C</span></label>
          </div>
        </fieldset>
      </div>
      <p class="hint">Used only for the peak time guide.</p>
    </div>

    <div class="mt-5">
      <p class="lbl">Clock times (optional)</p>
      <div class="grid grid-cols-2 gap-3">
        <div><label for="fedat" class="lbl">I feed at</label><input id="fedat" class="field" type="time" value={d.fedAt} autocomplete="off" /></div>
        <div><label for="readyby" class="lbl">I want it ready by</label><input id="readyby" class="field" type="time" value={d.readyBy} autocomplete="off" /></div>
      </div>
      <p class="hint">Fill in one to see clock times for the peak. Fill in both to get a ratio that fits your night.</p>
    </div>

    <details id="mix" class="mt-5 rounded-xl border border-line">
      <summary class="flex min-h-[3rem] cursor-pointer list-none items-center justify-between gap-3 px-4 font-semibold [&::-webkit-details-marker]:hidden">
        Flour mix (optional)
        <svg class="h-4 w-4 shrink-0 text-muted" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6l5 5 5-5"/></svg>
      </summary>
      <div class="px-4 pb-4">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Flour mix presets">
          <!-- data-mix is "whole wheat %,rye %" -->
          <button type="button" class="chip" data-mix="0,0" aria-pressed="true">All white</button>
          <button type="button" class="chip" data-mix="20,0" aria-pressed="false">80% white, 20% whole wheat</button>
          <button type="button" class="chip" data-mix="50,0" aria-pressed="false">50% white, 50% whole wheat</button>
          <button type="button" class="chip" data-mix="0,10" aria-pressed="false">90% white, 10% rye</button>
        </div>
        <div class="mt-3 grid grid-cols-2 gap-3">
          <div><label for="wheat" class="lbl">Whole wheat %</label><input id="wheat" class="field" type="text" inputmode="decimal" value="0" aria-describedby="note" /></div>
          <div><label for="rye" class="lbl">Rye %</label><input id="rye" class="field" type="text" inputmode="decimal" value="0" aria-describedby="note" /></div>
        </div>
        <p id="white-pct" class="hint">White flour (all-purpose or bread): 100%</p>
      </div>
    </details>
  </div>
</section>

<!-- Phone only: keeps the answer on screen while you change the inputs above it. Hidden while the result card shows. -->
<div id="sticky-bar" aria-hidden="true" class="fixed inset-x-0 bottom-0 z-20 border-t border-brand/30 bg-brand-soft/95 px-4 py-2 backdrop-blur lg:hidden">
  <div class="mx-auto flex max-w-5xl justify-between gap-3 text-center">
    <div><div class="text-xs text-muted">Starter</div><div id="bar-starter" class="serif text-lg font-bold tabular-nums">{r.starter} g</div></div>
    <div><div class="text-xs text-muted">Flour</div><div id="bar-flour" class="serif text-lg font-bold tabular-nums">{r.flour.total} g</div></div>
    <div><div class="text-xs text-muted">Water</div><div id="bar-water" class="serif text-lg font-bold tabular-nums">{r.water} g</div></div>
  </div>
</div>

<script>
  import { computeFeed, feedNote, ratioHint, ratioFlavor, jarLine, clockText, parseClock, peakTime, peakText, peakNote, gramsToCups, gramsToOz, fToC, cToF, nextAmount } from '../lib/starter.js';

  const $ = (id) => document.getElementById(id);
  const radio = (name) => document.querySelector(`input[name="${name}"]:checked`)?.value;
  const setRadio = (name, v) => { const el = document.querySelector(`input[name="${name}"][value="${v}"]`); if (el) el.checked = true; };
  // Accepts "7.5", "7,5" (decimal comma) and "1,500" (thousands comma). Anything else is NaN.
  const parseLoose = (raw) => {
    let v = raw.trim();
    if (/^\d{1,3}(,\d{3})+(\.\d+)?$/.test(v)) v = v.replace(/,/g, '');
    else if (/^\d+,\d+$/.test(v)) v = v.replace(',', '.');
    return v === '' ? NaN : Number(v);
  };
  const num = (id) => parseLoose($(id).value);
  const KEY = 'ssc-v1';
  const FIELDS = ['amount', 'jar', 'fedat', 'readyby', 'c-s', 'c-f', 'c-w', 'hydration', 'temp', 'wheat', 'rye'];
  const RADIOS = ['mode', 'ratio', 'unit', 'tunit'];
  const FLAGGED = { amount: ['amount'], jar: ['jar'], custom: ['c-s', 'c-f', 'c-w'], hydration: ['hydration'], mix: ['wheat', 'rye'] };
  const NA = '–';
  // tC holds the exact temperature in Celsius, so switching units back and forth does not drift.
  const state = { res: null, tC: NaN, text: '' };

  // A landing page opens on its own case, so it neither loads nor overwrites the saved settings.
  const isPreset = () => $('tool').dataset.preset === 'yes';

  // Share link: the settings live in the part after #, so nothing goes to a server.
  const HASH = { mode: 'm', ratio: 'r', unit: 'u', tunit: 'tu', amount: 'a', jar: 'j', fedat: 'f', readyby: 'b', 'c-s': 'cs', 'c-f': 'cf', 'c-w': 'cw', hydration: 'h', temp: 't', wheat: 'w', rye: 'y' };
  function toHash() {
    const q = new URLSearchParams();
    RADIOS.forEach((n) => { q.set(HASH[n], radio(n)); });
    FIELDS.forEach((id) => { if ($(id).value !== '') q.set(HASH[id], $(id).value); });
    return q.toString();
  }
  function fromHash() {
    try {
      const raw = location.hash.replace(/^#/, '');
      if (!raw.includes('=')) return false;
      const q = new URLSearchParams(raw);
      let any = false;
      FIELDS.forEach((id) => { const v = q.get(HASH[id]); if (v !== null && v.length < 12) { $(id).value = v; any = true; } });
      RADIOS.forEach((n) => { const v = q.get(HASH[n]); if (v !== null) { setRadio(n, v); any = true; } });
      return any;
    } catch { return false; }
  }

  function save() {
    if (isPreset()) return;
    try {
      const s = {};
      FIELDS.forEach((id) => { s[id] = $(id).value; });
      RADIOS.forEach((n) => { s[n] = radio(n); });
      localStorage.setItem(KEY, JSON.stringify(s));
    } catch {}
  }
  function load() {
    if (isPreset()) return;
    try {
      const s = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (!s) return;
      FIELDS.forEach((id) => { if (typeof s[id] === 'string') $(id).value = s[id]; });
      RADIOS.forEach((n) => { if (typeof s[n] === 'string') setRadio(n, s[n]); });
    } catch {}
  }

  const fmtG = (n) => `${n.toLocaleString('en-US')} g`;
  const show = (n, kind, unit) => (unit === 'cups' ? gramsToCups(n, kind) : unit === 'oz' ? gramsToOz(n) : fmtG(n));

  function readTemp() {
    const t = num('temp');
    state.tC = radio('tunit') === 'F' ? fToC(t) : t;
  }

  // Screen readers hear one short sentence, and only after typing pauses.
  let liveTimer;
  function announce(text) {
    clearTimeout(liveTimer);
    liveTimer = setTimeout(() => { $('live').textContent = text; }, 400);
  }

  function render() {
    const mode = radio('mode');
    const ratio = radio('ratio');
    const unit = radio('unit');
    const tunit = radio('tunit');
    // An empty box means 0. Letters stay NaN, so the mix is flagged as an error.
    const pct = (id) => ($(id).value.trim() === '' ? 0 : num(id));
    const wheat = pct('wheat');
    const rye = pct('rye');

    $('amount-label').textContent = mode === 'keep' ? 'Starter you keep (grams)' : 'Total starter you need (grams)';
    $('amount-hint').textContent = mode === 'keep'
      ? 'The starter left in the jar after you discard.'
      : 'The weight of fed starter you want, for example what a recipe needs.';
    $('custom').hidden = ratio !== 'custom';
    $('hyd-block').hidden = ratio === 'custom';
    $('white-pct').textContent = `White flour (all-purpose or bread): ${Number.isFinite(wheat + rye) ? `${Math.max(0, Math.round((100 - wheat - rye) * 10) / 10)}%` : NA}`;
    $('cups-note').hidden = unit !== 'cups';
    document.querySelectorAll('[data-chips]').forEach((g) => { g.hidden = g.dataset.chips !== mode; });
    $('ratio-flavor').textContent = ratioFlavor(ratio);

    document.querySelectorAll('[data-amount]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.amount) === num('amount'))));
    document.querySelectorAll('[data-hydration]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.hydration) === num('hydration'))));
    document.querySelectorAll('[data-mix]').forEach((b) => { const [w, r] = b.dataset.mix.split(',').map(Number); b.setAttribute('aria-pressed', String(w === wheat && r === rye)); });

    const res = computeFeed({
      mode, amount: num('amount'), jar: $('jar').value.trim() === '' ? '' : (Number.isNaN(num('jar')) ? Infinity : num('jar')), ratio, hydration: num('hydration'),
      custom: { s: num('c-s'), f: num('c-f'), w: num('c-w') },
      mix: { wheat, rye },
    });
    state.res = res;

    // Flag the field that caused an error.
    const bad = res.ok ? [] : (FLAGGED[res.field] || []);
    FIELDS.forEach((id) => { if (bad.includes(id)) $(id).setAttribute('aria-invalid', 'true'); else $(id).removeAttribute('aria-invalid'); });
    $('copy').disabled = !res.ok;

    const note = $('note');
    note.classList.toggle('text-muted', res.ok);
    note.classList.toggle('text-red-700', !res.ok);
    note.classList.toggle('dark:text-red-400', !res.ok);
    if (!res.ok) {
      ['out-starter', 'out-flour', 'out-water', 'out-total', 'bar-starter', 'bar-flour', 'bar-water'].forEach((id) => { $(id).textContent = NA; });
      ['row-white', 'row-wheat', 'row-rye'].forEach((id) => { $(id).hidden = true; });
      note.textContent = res.error;
      $('jar-line').textContent = NA;
      $('clock-line').hidden = true;
      $('peak').textContent = NA;
      $('peak-note').textContent = 'Fix the input to see a peak time.';
      announce(res.error);
      return;
    }

    const mixed = wheat > 0 || rye > 0;
    const starterTxt = show(res.starter, 'starter', unit);
    const flourTxt = mixed && unit === 'cups' ? 'see below' : show(res.flour.total, 'white', unit);
    const waterTxt = show(res.water, 'water', unit);
    $('out-starter').textContent = starterTxt;
    $('out-flour').textContent = flourTxt;
    $('out-water').textContent = waterTxt;
    $('out-total').textContent = unit === 'oz' ? gramsToOz(res.total) : fmtG(res.total);
    $('bar-starter').textContent = starterTxt;
    $('bar-flour').textContent = mixed && unit === 'cups' ? fmtG(res.flour.total) : flourTxt;
    $('bar-water').textContent = waterTxt;

    $('row-white').hidden = !mixed;
    $('row-wheat').hidden = res.flour.wheat === 0;
    $('row-rye').hidden = res.flour.rye === 0;
    if (mixed) {
      $('out-white').textContent = show(res.flour.white, 'white', unit);
      $('out-wheat').textContent = show(res.flour.wheat, 'wheat', unit);
      $('out-rye').textContent = show(res.flour.rye, 'rye', unit);
    }

    note.textContent = feedNote(res);
    $('jar-line').textContent = jarLine(res) ?? 'Type the weight of the starter in your jar to see how much to discard.';
    $('ratio-hint').textContent = ratioHint(res);
    announce(`Feed ${starterTxt} starter, ${flourTxt === 'see below' ? fmtG(res.flour.total) : flourTxt} flour and ${waterTxt} water.`);

    const t = num('temp');
    const pk = peakTime(res.dilution, state.tC);
    if (!pk.ok) {
      $('peak').textContent = NA;
      $('peak-note').textContent = 'Enter your kitchen temperature to see a rough peak time.';
    } else {
      $('peak').textContent = pk.cold || pk.hot ? NA : peakText(res.dilution, cToF(state.tC));
      $('peak-note').textContent = peakNote(pk, t, tunit, res.wholeGrainShare);
    }
    const clock = clockText({ pk, tC: state.tC, fed: parseClock($('fedat').value), ready: parseClock($('readyby').value), ratio });
    $('clock-line').textContent = clock;
    $('clock-line').hidden = !clock;
  }

  function update() { render(); save(); }
  function setValue(id, v) { $(id).value = String(v); update(); }

  const root = $('tool');
  root.addEventListener('input', (e) => {
    if (e.target.id === 'temp') readTemp();
    else if (e.target.name === 'tunit') {
      // Convert from the exact Celsius value and round only for display.
      if (Number.isFinite(state.tC)) $('temp').value = String(Math.round((e.target.value === 'F' ? cToF(state.tC) : state.tC) * 10) / 10);
    }
    update();
  });

  function copyText(r, unit) {
    const lines = [`Starter ${show(r.starter, 'starter', unit)}`];
    if (r.flour.wheat || r.flour.rye) {
      lines.push(`White flour ${show(r.flour.white, 'white', unit)}`);
      if (r.flour.wheat) lines.push(`Whole wheat flour ${show(r.flour.wheat, 'wheat', unit)}`);
      if (r.flour.rye) lines.push(`Rye flour ${show(r.flour.rye, 'rye', unit)}`);
    } else lines.push(`Flour ${show(r.flour.total, 'white', unit)}`);
    lines.push(`Water ${show(r.water, 'water', unit)}`, `Total ${fmtG(r.total)} (${r.ratioLabel})`);
    if (r.jar !== null) lines.push(jarLine(r));
    return lines.join('\n');
  }
  // Old browsers and plain http pages have no clipboard API; fall back to a hidden textarea.
  async function copyToClipboard(text) {
    try { await navigator.clipboard.writeText(text); return true; } catch {}
    try {
      const ta = document.createElement('textarea');
      ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;opacity:0';
      document.body.appendChild(ta); ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    } catch { return false; }
  }

  root.addEventListener('click', async (e) => {
    const b = e.target.closest('button');
    if (!b) return;
    if (b.dataset.amount) setValue('amount', b.dataset.amount);
    else if (b.dataset.hydration) setValue('hydration', b.dataset.hydration);
    else if (b.dataset.mix) {
      const [w, r] = b.dataset.mix.split(',');
      $('wheat').value = w; $('rye').value = r; update();
    } else if (b.id === 'amount-down' || b.id === 'amount-up') {
      setValue('amount', nextAmount(num('amount'), b.id === 'amount-up' ? 'up' : 'down'));
    } else if (b.id === 'print') {
      window.print();
    } else if (b.id === 'share') {
      const url = `${location.origin}${location.pathname}#${toHash()}`;
      history.replaceState(null, '', `#${toHash()}`);
      const ok = await copyToClipboard(url);
      b.textContent = ok ? 'Link copied' : 'Copy failed';
      $('copy-status').textContent = ok ? 'Link copied. It opens with your settings.' : 'Copy failed. Copy the address bar by hand.';
      setTimeout(() => { b.textContent = 'Copy link'; $('copy-status').textContent = ''; }, 2500);
    } else if (b.id === 'copy') {
      const r = state.res;
      if (!r || !r.ok) return;
      const ok = await copyToClipboard(copyText(r, radio('unit')));
      b.textContent = ok ? 'Copied' : 'Copy failed';
      $('copy-status').textContent = ok ? 'Amounts copied.' : 'Copy failed. Select the amounts by hand.';
      setTimeout(() => { b.textContent = 'Copy amounts'; $('copy-status').textContent = ''; }, 2500);
    }
  });

  // Show the phone bar only while the full result card is off screen.
  const bar = $('sticky-bar');
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => { bar.hidden = entry.isIntersecting; }, { threshold: 0.4 }).observe($('result'));
  }

  load();
  fromHash();
  readTemp();
  render();
</script>
